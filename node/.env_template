# Owner commitment (64 hex chars) — the on-chain token authority.
# Get it from the MintKey web app: create/unlock your passkey wallet, then use
# "Copy owner commitment" on the Mint page. The underlying secret never leaves
# your browser; deploys only ever see this hash.
OWNER_COMMITMENT=""

# Wallet mnemonics for remote networks (faucet-funded; never commit real secrets)
MY_PREVIEW_MNEMONIC=""
MY_PREPROD_MNEMONIC=""

# Standalone (undeployed) NIGHT funding target — copy from your wallet.
# NIGHT (unshielded) recipient: mn_addr_undeployed1...
MY_UNDEPLOYED_UNSHIELDED_ADDRESS=""

# Optional funding amount (whole tokens; scaled by 10^6 on send)
# FUND_AMOUNT=1000
