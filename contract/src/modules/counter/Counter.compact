pragma language_version >= 0.23;

/**
* @module: Counter
* @description: Public round counter. Owns the `_round` ledger state and the
* increment transition. Imported by the main contract with prefix Counter_,
* so state is exposed to TypeScript as `Counter__round`.
*/
module Counter {
  import CompactStandardLibrary;

  export ledger _round: Counter;

  export circuit increment(): [] {
    _round.increment(1);
  }
}
